# 复制为 .env 使用；不要提交真实值。已存在的环境变量优先。
# IP 类型检测总开关。auto 保持旧行为（IPPURE_ENABLED=1 时走 IPPure，否则走自定义模板）。
# ippure=强制 IPPure，custom=只用自定义模板，off=关闭全部检测。
INTELLIGENCE_PROVIDER=
# 可选的独立画像服务。URL 必须是 HTTPS 且包含 {ip}。
# 示例：https://iplocate.io/api/lookup/{ip}
# 示例：https://ipinfo.io/{ip}/json
# 示例：https://api.ipdata.co/{ip}
INTELLIGENCE_URL_TEMPLATE=
INTELLIGENCE_TOKEN=
# 自定义模板的鉴权方式。auto=有 token 走请求头，无 token 不鉴权。
# header（默认 X-API-Key）| bearer（Authorization: Bearer）| query（?token=）| none
INTELLIGENCE_AUTH_MODE=
INTELLIGENCE_AUTH_HEADER=
INTELLIGENCE_TOKEN_PARAM=
# 旧 IPPure 开关，PROVIDER 为空/auto 时仍有效。
# IPPURE_ENABLED=1
# IPPURE_URL=https://my.ippure.com/v1/info
# IPPURE_TIMEOUT_SECONDS=15
# 仅查国家，不证明住宅类型。
# COUNTRY_URL_TEMPLATE=https://api.country.is/{ip}
