#!/usr/bin/env bash
set -euo pipefail
case "${1:-status}" in
  install|update) shift; exec bash /usr/local/lib/vgatebox/install.sh --mode vps "$@" ;;
  uninstall) shift; exec python3 /usr/local/lib/vgatebox/deploy/uninstall.py "$@" ;;
  version) exec /usr/local/bin/vgatebox-fanout -version ;;
  check-update)
    python3 - <<'PY'
import pathlib,json,urllib.request
current=pathlib.Path('/usr/local/lib/vgatebox/VERSION').read_text().strip()
try:
 req=urllib.request.Request('https://api.github.com/repos/LiquorXR/vgatebox/releases/latest',headers={'Accept':'application/vnd.github+json','User-Agent':'vgatebox-updater'})
 with urllib.request.urlopen(req,timeout=15) as r:latest=json.load(r)
 print('当前版本：'+current);print('最新正式版：'+latest['tag_name']);print('在线更新：管理页「设置 → 版本与更新」，或 vgatebox update')
except (OSError,ValueError,KeyError):raise SystemExit('检查更新失败，请稍后重试')
PY
    ;;
  update-status) exec python3 /usr/local/lib/vgatebox/deploy/installer.py status ;;
  status) systemctl --no-pager status vgatebox-fanout.service vgatebox-pool.timer ;;
  refresh)
    # Manual refresh neither arms an automatic check nor leaves a running one:
    # cancel any active check first (best effort), then record this pool
    # generation as covered once the refresh succeeds.
    python3 - <<'PY' 2>/dev/null || true
import http.client,json,pathlib,urllib.parse
try:
 p=pathlib.Path('/var/lib/vgatebox/fanout/state');s=json.loads((p/'settings.json').read_text());base='/'+(p/'basepath').read_text().strip().strip('/');pw=(p/'password').read_text().strip()
 listen=s.get('listen_addr') or '0.0.0.0';host='127.0.0.1' if listen in ('0.0.0.0','all','::') else listen
 c=http.client.HTTPConnection(host,int(s['port']),timeout=3);c.request('POST',base+'/login',urllib.parse.urlencode({'password':pw}),{'Content-Type':'application/x-www-form-urlencoded'});r=c.getresponse();r.read();cookie=r.getheader('Set-Cookie','').split(';')[0]
 c.request('POST',base+'/api/console/check/cancel',headers={'Cookie':cookie});c.getresponse().read();c.close()
except Exception:pass
PY
    if python3 /usr/local/lib/vgatebox/scripts/toolbox.py --config /etc/vgatebox/pool.json pool --output /var/lib/vgatebox/pool --schedule-dir /var/lib/vgatebox/fanout/state; then
      python3 - <<'PY' 2>/dev/null || true
import json,pathlib
try:
 d=json.loads(pathlib.Path('/var/lib/vgatebox/pool/node_pool.json').read_text());gen=str(d.get('generated_at') or '').strip()
 if gen:
  m=pathlib.Path('/var/lib/vgatebox/fanout/state/manual-refresh.json');m.write_text(json.dumps({'pool_generated_at':gen}));m.chmod(0o600)
except Exception:pass
PY
    else
      exit $?
    fi ;;
  restart) systemctl restart vgatebox-fanout.service ;;
  access)
    python3 - <<'PY'
import pathlib,json,http.client,urllib.parse
p=pathlib.Path('/var/lib/vgatebox/fanout/state');s=json.loads((p/'settings.json').read_text());base='/'+(p/'basepath').read_text().strip().strip('/');password=(p/'password').read_text().strip()
listen=s.get('listen_addr') or '0.0.0.0';host='127.0.0.1' if listen in ('0.0.0.0','all','::') else listen
public='<VPS公网IP>'
try:
 c=http.client.HTTPConnection(host,int(s['port']),timeout=3);c.request('POST',base+'/login',urllib.parse.urlencode({'password':password}),{'Content-Type':'application/x-www-form-urlencoded'});r=c.getresponse();r.read();cookie=r.getheader('Set-Cookie','').split(';')[0]
 c.request('GET',base+'/api/exits',headers={'Cookie':cookie});r=c.getresponse();view=json.loads(r.read());public=view.get('public_ip') or public;c.close()
except (OSError,ValueError,http.client.HTTPException):pass
if listen in ('127.0.0.1','::1','localhost'):public='127.0.0.1'
print('管理地址：http://'+public+':'+str(s['port'])+base+'/');print('管理密码：'+password)
if public=='127.0.0.1':print('当前只允许本机访问，请使用 SSH 端口转发。')
PY
    ;;
  *) echo '用法：vgatebox {version|check-update|update [--version vX.Y.Z]|update-status|status|refresh|restart|access|uninstall [--dry-run] [--purge] [--legacy] [--yes]}'; exit 1 ;;
esac
